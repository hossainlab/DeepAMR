# DeepAMR Environment Configuration

# Admin password for initial setup (required in production)
DEEPAMR_ADMIN_PASSWORD=changeme

# Comma-separated list of allowed CORS origins
# For Vercel: CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Frontend API URL (set to backend URL in production)
# For Vercel: NEXT_PUBLIC_API_URL=https://your-backend.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000
